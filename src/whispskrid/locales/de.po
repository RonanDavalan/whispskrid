#: cli.py:35
msgid "affiche la version et quitte"
msgstr "Version anzeigen und beenden"

#: cli.py:37
msgid "force la langue de l'interface et de la reconnaissance"
msgstr "Sprache der Oberfläche und Erkennung erzwingen"

#: cli.py:39
msgid "surcharge models.default pour cette session"
msgstr "models.default für diese Sitzung überschreiben"

#: cli.py:43
msgid "démarre la capture (session en cours)"
msgstr "Aufnahme starten (Sitzung muss laufen)"

#: cli.py:44
msgid "arrête la capture, transcrit, injecte"
msgstr "Aufnahme beenden, transkribieren, einfügen"

#: cli.py:45
msgid "dictate ou dictate-stop selon l'état"
msgstr "dictate oder dictate-stop je nach Status"

#: cli.py:46
msgid "jette la capture en cours sans injecter"
msgstr "laufende Aufnahme verwerfen, ohne einzufügen"

#: cli.py:47
msgid "imprime l'état de la session en cours"
msgstr "Status der laufenden Sitzung anzeigen"

#: cli.py:48
msgid "arrête la session persistante en cours"
msgstr "laufende persistente Sitzung beenden"

#: cli.py:49
msgid "vérifie l'environnement et quitte"
msgstr "Umgebung prüfen und beenden"

#: cli.py:51
msgid "télécharge un modèle et quitte"
msgstr "Modell herunterladen und beenden"

#: cli.py:122
msgid ""
"whispskrid : une session persistante tourne déjà — arrêtez-la (--stop) avant "
"d'en ouvrir une seconde."
msgstr ""
"whispskrid: Es läuft bereits eine persistente Sitzung — beenden Sie sie (--"
"stop), bevor Sie eine zweite öffnen."

#: cli.py:131 cli.py:170 cli.py:305
#, python-brace-format
msgid "whispskrid : {erreur}"
msgstr "whispskrid: {erreur}"

#: cli.py:140
msgid ""
"whispskrid : vad.enabled=true non encore implémenté — poursuite en appui-"
"pour-parler strict."
msgstr ""
"whispskrid: vad.enabled=true ist noch nicht implementiert — weiter im "
"strikten Push-to-Talk-Modus."

#: cli.py:157
#, python-brace-format
msgid ""
"whispskrid : modèle « {nom} » absent, téléchargement automatique en cours "
"(~{taille} Mo, depuis huggingface.co/Systran) — aucune barre de progression, "
"patientez..."
msgstr ""
"whispskrid: Modell \"{nom}\" nicht vorhanden, automatischer Download läuft "
"(~{taille} MB, von huggingface.co/Systran) — kein Fortschrittsbalken, bitte "
"warten..."

#: cli.py:177
#, python-brace-format
msgid "whispskrid : impossible d'ouvrir l'entrée audio : {erreur}"
msgstr "whispskrid: Audioeingang konnte nicht geöffnet werden: {erreur}"

#: cli.py:202
#, python-brace-format
msgid ""
"whispskrid : écouteur pynput indisponible ({erreur}) — session pilotable par "
"la socket de contrôle seule."
msgstr ""
"whispskrid: pynput-Listener nicht verfügbar ({erreur}) — Sitzung weiterhin "
"allein über die Kontroll-Socket steuerbar."

#: cli.py:211
msgid ""
"whispskrid : hotkeys.mode: armed exige l'écouteur pynput (armement/"
"désarmement exclusivement au clavier) — indisponible ici, le mode armé ne "
"peut pas être utilisé."
msgstr ""
"whispskrid: hotkeys.mode: armed erfordert den pynput-Listener (Aktivieren/"
"Deaktivieren ausschließlich über die Tastatur) — hier nicht verfügbar, der "
"Modus „armed“ kann nicht verwendet werden."

#: cli.py:221
#, python-brace-format
msgid ""
"whispskrid : mode armé — appuyez sur la touche pour armer l'écoute, dites "
"« {ouverture} » pour commencer un segment et « {cloture} » pour le "
"terminer ; un second appui désarme."
msgstr ""
"whispskrid: Modus „armed“ — drücken Sie die Taste, um das Zuhören zu "
"aktivieren, sagen Sie „{ouverture}“, um ein Segment zu beginnen, und "
"„{cloture}“, um es zu beenden; ein erneuter Tastendruck deaktiviert es."

#: cli.py:228
#, python-brace-format
msgid "whispskrid {version} — prêt (modèle {modele}, langue {langue})."
msgstr "whispskrid {version} — bereit (Modell {modele}, Sprache {langue})."

#: cli.py:229
msgid "auto"
msgstr "automatisch"

#: cli.py:250
#, python-brace-format
msgid "whispskrid : modèle « {nom} » inconnu — modèles disponibles : {liste}."
msgstr ""
"whispskrid: unbekanntes Modell \"{nom}\" — verfügbare Modelle: {liste}."

#: cli.py:259
#, python-brace-format
msgid "whispskrid : modèle « {nom} » déjà présent dans {chemin}."
msgstr "whispskrid: Modell \"{nom}\" bereits vorhanden unter {chemin}."

#: cli.py:266
#, python-brace-format
msgid ""
"whispskrid : téléchargement du modèle « {nom} » (~{taille} Mo, depuis "
"huggingface.co/Systran) — aucune barre de progression, patientez jusqu'au "
"message final..."
msgstr ""
"whispskrid: Herunterladen des Modells \"{nom}\" (~{taille} MB, von "
"huggingface.co/Systran) — kein Fortschrittsbalken, bitte auf die "
"Abschlussmeldung warten..."

#: cli.py:273
#, python-brace-format
msgid "whispskrid : échec du téléchargement : {erreur}"
msgstr "whispskrid: Download fehlgeschlagen: {erreur}"

#: cli.py:276
#, python-brace-format
msgid "whispskrid : modèle « {nom} » prêt dans {chemin}."
msgstr "whispskrid: Modell \"{nom}\" bereit unter {chemin}."

