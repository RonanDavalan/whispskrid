#: cli.py:35
msgid "affiche la version et quitte"
msgstr "show the version and exit"

#: cli.py:37
msgid "force la langue de l'interface et de la reconnaissance"
msgstr "force the interface and recognition language"

#: cli.py:39
msgid "surcharge models.default pour cette session"
msgstr "override models.default for this session"

#: cli.py:43
msgid "démarre la capture (session en cours)"
msgstr "start capture (session must be running)"

#: cli.py:44
msgid "arrête la capture, transcrit, injecte"
msgstr "stop capture, transcribe, inject"

#: cli.py:45
msgid "dictate ou dictate-stop selon l'état"
msgstr "dictate or dictate-stop depending on state"

#: cli.py:46
msgid "jette la capture en cours sans injecter"
msgstr "discard the current capture without injecting"

#: cli.py:47
msgid "imprime l'état de la session en cours"
msgstr "print the current session status"

#: cli.py:48
msgid "arrête la session persistante en cours"
msgstr "stop the running persistent session"

#: cli.py:49
msgid "vérifie l'environnement et quitte"
msgstr "check the environment and exit"

#: cli.py:51
msgid "télécharge un modèle et quitte"
msgstr "download a model and exit"

#: cli.py:122
msgid ""
"whispskrid : une session persistante tourne déjà — arrêtez-la (--stop) avant "
"d'en ouvrir une seconde."
msgstr ""
"whispskrid: a persistent session is already running — stop it (--stop) "
"before opening a second one."

#: cli.py:131 cli.py:170 cli.py:309
#, python-brace-format
msgid "whispskrid : {erreur}"
msgstr "whispskrid: {erreur}"

#: cli.py:140
msgid ""
"whispskrid : vad.enabled=true non encore implémenté — poursuite en appui-"
"pour-parler strict."
msgstr ""
"whispskrid: vad.enabled=true not implemented yet — continuing in strict push-"
"to-talk mode."

#: cli.py:157
#, python-brace-format
msgid ""
"whispskrid : modèle « {nom} » absent, téléchargement automatique en cours "
"(~{taille} Mo, depuis huggingface.co/Systran) — aucune barre de progression, "
"patientez..."
msgstr ""
"whispskrid: model \"{nom}\" absent, automatic download in progress "
"(~{taille} MB, from huggingface.co/Systran) — no progress bar, please wait..."

#: cli.py:177
#, python-brace-format
msgid "whispskrid : impossible d'ouvrir l'entrée audio : {erreur}"
msgstr "whispskrid: could not open the audio input: {erreur}"

#: cli.py:202
#, python-brace-format
msgid ""
"whispskrid : écouteur pynput indisponible ({erreur}) — session pilotable par "
"la socket de contrôle seule."
msgstr ""
"whispskrid: pynput listener unavailable ({erreur}) — session can still be "
"controlled via the control socket alone."

#: cli.py:211
msgid ""
"whispskrid : hotkeys.mode: armed exige l'écouteur pynput (armement/"
"désarmement exclusivement au clavier) — indisponible ici, le mode armé ne "
"peut pas être utilisé."
msgstr ""
"whispskrid: hotkeys.mode: armed requires the pynput listener (arming/"
"disarming is keyboard-only) — unavailable here, armed mode cannot be used."

#: cli.py:221
#, python-brace-format
msgid ""
"whispskrid : mode armé — appuyez sur la touche pour armer l'écoute, dites "
"« {ouverture} » pour commencer un segment et « {cloture} » pour le "
"terminer ; un second appui désarme."
msgstr ""
"whispskrid: armed mode — press the key to arm listening, say “{ouverture}” "
"to start a segment and “{cloture}” to end it; a second press disarms."

#: cli.py:228
#, python-brace-format
msgid "whispskrid {version} — prêt (modèle {modele}, langue {langue})."
msgstr "whispskrid {version} — ready (model {modele}, language {langue})."

#: cli.py:229
msgid "auto"
msgstr "auto"

#: cli.py:250
#, python-brace-format
msgid "whispskrid : modèle « {nom} » inconnu — modèles disponibles : {liste}."
msgstr "whispskrid: unknown model \"{nom}\" — available models: {liste}."

#: cli.py:259
#, python-brace-format
msgid "whispskrid : modèle « {nom} » déjà présent dans {chemin}."
msgstr "whispskrid: model \"{nom}\" already present in {chemin}."

#: cli.py:266
#, python-brace-format
msgid ""
"whispskrid : téléchargement du modèle « {nom} » (~{taille} Mo, depuis "
"huggingface.co/Systran) — aucune barre de progression, patientez jusqu'au "
"message final..."
msgstr ""
"whispskrid: downloading model \"{nom}\" (~{taille} MB, from huggingface.co/"
"Systran) — no progress bar, wait for the final message..."

#: cli.py:273
#, python-brace-format
msgid "whispskrid : échec du téléchargement : {erreur}"
msgstr "whispskrid: download failed: {erreur}"

#: cli.py:276
#, python-brace-format
msgid "whispskrid : modèle « {nom} » prêt dans {chemin}."
msgstr "whispskrid: model \"{nom}\" ready in {chemin}."

