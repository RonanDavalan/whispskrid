#: cli.py:35
msgid "affiche la version et quitte"
msgstr "mostrar la versión y salir"

#: cli.py:37
msgid "force la langue de l'interface et de la reconnaissance"
msgstr "forzar el idioma de la interfaz y del reconocimiento"

#: cli.py:39
msgid "surcharge models.default pour cette session"
msgstr "sobrescribir models.default para esta sesión"

#: cli.py:43
msgid "démarre la capture (session en cours)"
msgstr "iniciar la captura (la sesión debe estar en marcha)"

#: cli.py:44
msgid "arrête la capture, transcrit, injecte"
msgstr "detener la captura, transcribir, inyectar"

#: cli.py:45
msgid "dictate ou dictate-stop selon l'état"
msgstr "dictate o dictate-stop según el estado"

#: cli.py:46
msgid "jette la capture en cours sans injecter"
msgstr "descartar la captura en curso sin inyectar"

#: cli.py:47
msgid "imprime l'état de la session en cours"
msgstr "mostrar el estado de la sesión en curso"

#: cli.py:48
msgid "arrête la session persistante en cours"
msgstr "detener la sesión persistente en curso"

#: cli.py:49
msgid "vérifie l'environnement et quitte"
msgstr "comprobar el entorno y salir"

#: cli.py:51
msgid "télécharge un modèle et quitte"
msgstr "descargar un modelo y salir"

#: cli.py:122
msgid ""
"whispskrid : une session persistante tourne déjà — arrêtez-la (--stop) avant "
"d'en ouvrir une seconde."
msgstr ""
"whispskrid: ya hay una sesión persistente en curso — deténgala (--stop) antes "
"de abrir una segunda."

#: cli.py:131 cli.py:170 cli.py:305
#, python-brace-format
msgid "whispskrid : {erreur}"
msgstr "whispskrid: {erreur}"

#: cli.py:140
msgid ""
"whispskrid : vad.enabled=true non encore implémenté — poursuite en appui-"
"pour-parler strict."
msgstr ""
"whispskrid: vad.enabled=true aún no está implementado — se continúa en modo "
"pulsar-para-hablar estricto."

#: cli.py:157
#, python-brace-format
msgid ""
"whispskrid : modèle « {nom} » absent, téléchargement automatique en cours "
"(~{taille} Mo, depuis huggingface.co/Systran) — aucune barre de progression, "
"patientez..."
msgstr ""
"whispskrid: modelo \"{nom}\" ausente, descarga automática en curso "
"(~{taille} MB, desde huggingface.co/Systran) — sin barra de progreso, "
"espere..."

#: cli.py:177
#, python-brace-format
msgid "whispskrid : impossible d'ouvrir l'entrée audio : {erreur}"
msgstr "whispskrid: no se pudo abrir la entrada de audio: {erreur}"

#: cli.py:202
#, python-brace-format
msgid ""
"whispskrid : écouteur pynput indisponible ({erreur}) — session pilotable par "
"la socket de contrôle seule."
msgstr ""
"whispskrid: listener pynput no disponible ({erreur}) — la sesión sigue "
"siendo controlable únicamente mediante el socket de control."

#: cli.py:211
msgid ""
"whispskrid : hotkeys.mode: armed exige l'écouteur pynput (armement/"
"désarmement exclusivement au clavier) — indisponible ici, le mode armé ne "
"peut pas être utilisé."
msgstr ""
"whispskrid: hotkeys.mode: armed requiere el listener pynput (activar/"
"desactivar exclusivamente con el teclado) — no disponible aquí, el modo "
"armed no se puede usar."

#: cli.py:221
#, python-brace-format
msgid ""
"whispskrid : mode armé — appuyez sur la touche pour armer l'écoute, dites "
"« {ouverture} » pour commencer un segment et « {cloture} » pour le "
"terminer ; un second appui désarme."
msgstr ""
"whispskrid: modo armed — pulse la tecla para activar la escucha, diga "
"«{ouverture}» para iniciar un segmento y «{cloture}» para terminarlo; una "
"segunda pulsación lo desactiva."

#: cli.py:228
#, python-brace-format
msgid "whispskrid {version} — prêt (modèle {modele}, langue {langue})."
msgstr "whispskrid {version} — listo (modelo {modele}, idioma {langue})."

#: cli.py:229
msgid "auto"
msgstr "auto"

#: cli.py:250
#, python-brace-format
msgid "whispskrid : modèle « {nom} » inconnu — modèles disponibles : {liste}."
msgstr ""
"whispskrid: modelo \"{nom}\" desconocido — modelos disponibles: {liste}."

#: cli.py:259
#, python-brace-format
msgid "whispskrid : modèle « {nom} » déjà présent dans {chemin}."
msgstr "whispskrid: modelo \"{nom}\" ya presente en {chemin}."

#: cli.py:266
#, python-brace-format
msgid ""
"whispskrid : téléchargement du modèle « {nom} » (~{taille} Mo, depuis "
"huggingface.co/Systran) — aucune barre de progression, patientez jusqu'au "
"message final..."
msgstr ""
"whispskrid: descargando el modelo \"{nom}\" (~{taille} MB, desde "
"huggingface.co/Systran) — sin barra de progreso, espere el mensaje final..."

#: cli.py:273
#, python-brace-format
msgid "whispskrid : échec du téléchargement : {erreur}"
msgstr "whispskrid: fallo en la descarga: {erreur}"

#: cli.py:276
#, python-brace-format
msgid "whispskrid : modèle « {nom} » prêt dans {chemin}."
msgstr "whispskrid: modelo \"{nom}\" listo en {chemin}."

